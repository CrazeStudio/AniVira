{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/search", "destination": "/search.html" },
    { "source": "/anime", "destination": "/anime.html" },
    { "source": "/watch", "destination": "/watch.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/rights", "destination": "/rights.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data: https://*.anilist.co; connect-src 'self' https://graphql.anilist.co; frame-src https://www.youtube-nocookie.com; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests" }
      ]
    }
  ]
}